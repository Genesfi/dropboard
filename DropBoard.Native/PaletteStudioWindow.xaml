<Window x:Class="DropBoard.Native.PaletteStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Palette Studio"
        Width="1060" Height="660"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with DropShadow -->
    <Border Background="#12151F"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Custom Title & Control Bar -->
            <Border Grid.Row="0"
                    Background="#181C2A"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 13.66,22 15,20.66 15,19 C 15,18.24 14.69,17.56 14.19,17.06 C 13.69,16.56 13.38,15.88 13.38,15.12 C 13.38,13.46 14.72,12.12 16.38,12.12 L 18,12.12 C 20.21,12.12 22,10.33 22,8.12 C 22,4.74 17.52,2 12,2 Z"
                                  Fill="#38BDF8"/>
                        </Viewbox>
                        <TextBlock Text="COLOR PALETTE GENERATOR"
                                   FontFamily="Segoe UI, Inter"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Border Background="#2538BDF8" CornerRadius="4" Padding="6,2,6,2" Margin="10,0,0,0">
                            <TextBlock Text="STUDIO" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Controls: Mood, Count, Randomize -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Mood Selector -->
                        <TextBlock Text="Mood:" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbMood"
                                  Width="110" Height="28"
                                  Background="#242B3D"
                                  Foreground="White"
                                  BorderBrush="#40FFFFFF"
                                  FontSize="11.5"
                                  SelectionChanged="CmbMood_SelectionChanged">
                            <ComboBoxItem Content="Colorful" IsSelected="True"/>
                            <ComboBoxItem Content="Bright"/>
                            <ComboBoxItem Content="Muted"/>
                            <ComboBoxItem Content="Deep"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Dominant"/>
                        </ComboBox>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="16" Fill="#30FFFFFF" Margin="14,0,14,0"/>

                        <!-- Swatch Count Stepper -->
                        <TextBlock Text="Colors:" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Background="#242B3D" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="5" Height="28">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnDecCount" Content="−" Width="24" Height="26" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDecCount_Click"/>
                                <TextBlock x:Name="TxtCount" Text="5" Width="20" TextAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <Button x:Name="BtnIncCount" Content="+" Width="24" Height="26" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnIncCount_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="16" Fill="#30FFFFFF" Margin="14,0,14,0"/>

                        <!-- Randomize Button -->
                        <Border x:Name="BtnRandomize"
                                Background="#2A334A"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,4,12,4"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnRandomize_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Data="M 10.59,9.17 L 5.41,4 L 4,5.41 L 9.17,10.59 L 10.59,9.17 Z M 14.5,4 L 16.54,6.04 L 4,18.59 L 5.41,20 L 17.96,7.46 L 20,9.5 L 20,4 L 14.5,4 Z M 14.83,13.41 L 13.42,14.82 L 16.55,17.95 L 14.5,20 L 20,20 L 20,14.5 L 17.96,16.54 L 14.83,13.41 Z"
                                          Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="Generate Random" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Border Grid.Column="2"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Main Body Content (Left: Image + Pins, Right: Vertical Color Bars) -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" MinWidth="300" MaxWidth="550"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Source Image Canvas with Draggable Sampling Pins -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="REFERENCE IMAGE (DRAG PINS TO SAMPLE)"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="2,0,0,6"/>

                    <Border Grid.Row="1"
                            Background="#161A26"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <!-- Image Container with Overlay Canvas for Pins -->
                        <Grid x:Name="ImageHostGrid"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              SizeChanged="ImageHostGrid_SizeChanged"
                              MouseLeftButtonDown="ImageHostGrid_MouseLeftButtonDown">
                            <Image x:Name="ImgPreview"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SizeChanged="ImgPreview_SizeChanged"/>

                            <!-- Draggable Pins Canvas placed exactly over the rendered image -->
                            <Canvas x:Name="PinsCanvas"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="True"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Column Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="#20FFFFFF" HorizontalAlignment="Center"/>

                <!-- Right Column: Big Vertical Palette Swatches -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="HARMONIC PALETTE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="2,0,0,6"/>

                    <!-- Container for dynamic vertical swatches -->
                    <Border Grid.Row="1"
                            Background="#161A26"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Grid x:Name="SwatchesContainerGrid"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Bottom Footer Action Bar -->
            <Border Grid.Row="2"
                    Background="#181C2A"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hint / Instructions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 Tip: Drag circular pins on the image to fine-tune colors • Click pin lock icon to freeze favorites"
                                   Foreground="#64748B"
                                   FontSize="11.5"/>
                    </StackPanel>

                    <!-- Export Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Copy Image -->
                        <Border x:Name="BtnCopyImage"
                                Background="#242B3D"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6,12,6"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="Copy rendered palette image to Clipboard"
                                MouseLeftButtonDown="BtnCopyImage_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 Copy Image" FontSize="11.5" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- Save PNG -->
                        <Border x:Name="BtnSavePng"
                                Background="#242B3D"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6,12,6"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="Save palette graphic as PNG for Photoshop/Figma"
                                MouseLeftButtonDown="BtnSavePng_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾 Save PNG" FontSize="11.5" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- Export to AE -->
                        <Border x:Name="BtnExportAe"
                                Background="#4F46E5"
                                BorderBrush="#818CF8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6,14,6"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="Export palette as image reference into Adobe After Effects"
                                MouseLeftButtonDown="BtnExportAe_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ae Export to AE" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Add to Board (Primary) -->
                        <Border x:Name="BtnAddToBoard"
                                Background="#0284C7"
                                BorderBrush="#38BDF8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,6,16,6"
                                Cursor="Hand"
                                ToolTip="Add this palette graphic as a new card on the DropBoard canvas"
                                MouseLeftButtonDown="BtnAddToBoard_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➕ Add to Board" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
