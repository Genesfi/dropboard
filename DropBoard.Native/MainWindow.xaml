                                                        <Path x:Name="IconNavWinPath" Data="M 3,4.5 L 10.5,3.5 L 10.5,11 L 3,11 Z M 12,3.3 L 21,2 L 21,11 L 12,11 Z M 3,12.5 L 10.5,12.5 L 10.5,20 L 3,19 Z M 12,12.5 L 21,12.5 L 21,21.5 L 12,20.2 Z" Fill="#94A3B8"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="TxtNavWinTitle" Text="Windows Precision" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Standard PC Pan &amp; Zoom" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Classic Mouse -->
                                    <Border x:Name="CardNavMouse" Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="SelectNavMode_Click" Tag="mouse">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Rectangle x:Name="IconNavMouseBody" Canvas.Left="6" Canvas.Top="3" Width="12" Height="18" RadiusX="6" RadiusY="6" Stroke="#94A3B8" StrokeThickness="1.8" Fill="Transparent"/>
                                                        <Line x:Name="IconNavMouseWheel" X1="12" Y1="6" X2="12" Y2="10" Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                                        <Line x:Name="IconNavMouseDiv" X1="12" Y1="3" X2="12" Y2="6" Stroke="#94A3B8" StrokeThickness="1"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="TxtNavMouseTitle" Text="Classic Mouse" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Wheel Zooms (PureRef)" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderPanSens" Style="{StaticResource CanvasOpacitySliderStyle}" Width="130" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="SliderPanSens_ValueChanged"/>
                                            <TextBlock x:Name="TxtPanSens" Text="1.0x" Width="36" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Touchpad Pan Sensitivity" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Adjust movement speed when panning canvas." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderZoomSens" Style="{StaticResource CanvasOpacitySliderStyle}" Width="130" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="SliderZoomSens_ValueChanged"/>
                                            <TextBlock x:Name="TxtZoomSens" Text="1.0x" Width="36" TextAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Zoom Sensitivity" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Fine-tune smoothness and scale speed of canvas zooming." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="ChkInvertPan" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="ChkInvertPan_Changed" Unchecked="ChkInvertPan_Changed"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Invert Pan Direction" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Reverse canvas scrolling direction for 2-finger swipe / wheel gestures." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 3: Toolbar & Layout -->
                            <StackPanel x:Name="PaneToolbar" Visibility="Collapsed">
                                <TextBlock Text="Toolbar Position" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose where the floating action dock appears on screen." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- Top Bar Card -->
                                    <Border x:Name="CardDockTop" Background="#0C1019" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="SelectDockPos_Click" Tag="top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Rectangle x:Name="IconDockTopWin" Canvas.Left="2" Canvas.Top="3" Width="20" Height="18" RadiusX="3" RadiusY="3" Stroke="#38BDF8" StrokeThickness="1.5" Fill="Transparent"/>
                                                        <Rectangle x:Name="IconDockTopBar" Canvas.Left="5" Canvas.Top="6" Width="14" Height="3.5" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="TxtDockTopTitle" Text="Top Bar" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Default horizontal floating action dock." FontSize="10.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Left Sidebar Card -->
                                    <Border x:Name="CardDockLeft" Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="SelectDockPos_Click" Tag="left">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Rectangle x:Name="IconDockLeftWin" Canvas.Left="2" Canvas.Top="3" Width="20" Height="18" RadiusX="3" RadiusY="3" Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"/>
                                                        <Rectangle x:Name="IconDockLeftBar" Canvas.Left="5" Canvas.Top="6" Width="3.5" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="#94A3B8"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="TxtDockLeftTitle" Text="Left Sidebar" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Compact vertical 1x mode for vertical monitors." FontSize="10.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="ChkAutoHideDock" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="ChkAutoHideDock_Changed" Unchecked="ChkAutoHideDock_Changed"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Auto-Hide Toolbar on Hover (Float Mode)" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Automatically slides out floating dock to maximize canvas workspace, revealing when cursor approaches." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="ChkTransparentTitlebar" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="ChkTransparentTitlebar_Changed" Unchecked="ChkTransparentTitlebar_Changed"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Transparent Glass Top Bar" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Makes the top bar background fully transparent to blend with the canvas/desktop, while keeping all icons, buttons, and resize controls completely solid and clickable." FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 4: Shortcuts -->
                            <StackPanel x:Name="PaneShortcuts" Visibility="Collapsed">
                                <TextBlock Text="Keyboard &amp; Mouse Shortcuts" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2">
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Space+Drag / Right-Click" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Pan Canvas" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Scroll Wheel" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Zoom Canvas" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + V" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Paste Image / URL" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + D" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Duplicate Selection" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + G" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Group Selected" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + A" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Select All" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Delete / Backspace" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Delete Selected" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + S" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Save Project" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + O" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Open Project" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl + Z / Ctrl + Y" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Undo / Redo" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="Enter / Esc" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Apply / Cancel Crop" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,6">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="F / Home" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/><TextBlock Text="Fit All in View" Foreground="#E2E8F0" FontSize="11"/></DockPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Tab 5: Storage & Cache -->
                            <StackPanel x:Name="PaneStorage" Visibility="Collapsed">
                                <TextBlock Text="Local Disk &amp; Cache Storage" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,4"/>
                                <TextBlock Text="Web &amp; clipboard references are cached locally for offline and instant high-res loading." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtStatCards" Text="0" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Active References" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,3,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtStatGroups" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Scene Groups" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtStatNotes" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Notes &amp; Palettes" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                 <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Content="Open Folder" Click="BtnOpenPalettesFolder_Click" Padding="12,5" Foreground="#F59E0B" BorderBrush="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Open Saved Palettes Folder in Explorer" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Browse exported and saved color palette PNG images on disk." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Content="Open Folder" Click="BtnOpenCacheFolder_Click" Padding="12,5" Foreground="#38BDF8" BorderBrush="#38BDF8" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Open Image Cache Folder in Explorer" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Browse downloaded high-resolution offline images on disk." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Content="Clear Cache" Click="BtnClearCacheStorage_Click" Padding="12,5" Foreground="#EF4444" BorderBrush="#EF4444" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Clear Downloaded Image Cache" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
                                            <TextBlock Text="Frees temporary disk space. Referenced files from web will redownload when opened." FontSize="10.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 6: About & Creator -->
                            <StackPanel x:Name="PaneAbout" Visibility="Collapsed">
                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="CREATOR &amp; DEVELOPER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="MG" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Migi Gustian" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,8,0"/>
                                                    <Border Background="#2538BDF8" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="Creator" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource TbButton}" Click="BtnOpenX_Click" Margin="0,0,8,0" Padding="8,4" Background="#1E293B" BorderBrush="#334155">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 18.244 2.25 h 3.308 l -7.227 8.26 8.502 11.24 H 16.17 l -5.214 -6.817 L 4.99 21.75 H 1.68 l 7.73 -8.835 L 1.254 2.25 H 8.08 l 4.713 6.231 z m -1.161 17.52 h 1.833 L 7.084 4.126 H 5.117 z" Fill="#E2E8F0"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="@migi_gn" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                                                <Canvas Width="24" Height="24">
                                                                    <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="16" RadiusX="2" RadiusY="2" Stroke="#94A3B8" StrokeThickness="1.8" Fill="Transparent"/>
                                                                    <Path Data="M 2,7 L 12,13 L 22,7" Stroke="#94A3B8" StrokeThickness="1.8" Fill="Transparent"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="gnmigi@gmail.com" FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <Button Content="Copy" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCopyEmail_Click" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3" Background="#141824" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="18,12">
                        <Button HorizontalAlignment="Right" Style="{StaticResource TbButton}" Content="Done" Click="BtnCloseSettingsModal_Click"
                                Background="#38BDF8" Foreground="#000000" FontWeight="Bold" Padding="20,6" BorderThickness="0"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- High-Performance Batch Import Progress Modal Overlay -->
        <Grid x:Name="ImportProgressModalOverlay" Panel.ZIndex="3500" Visibility="Collapsed" Background="#90070A0F">
            <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FA0E131F" BorderBrush="#5038BDF8" BorderThickness="1.2"
                    CornerRadius="14" Padding="24,20" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.85" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Top Icon + Header -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1A38BDF8" BorderBrush="#3538BDF8" BorderThickness="1" Margin="0,0,12,0">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,3 L 12,15 M 12,3 L 7,8 M 12,3 L 17,8 M 4,17 L 4,20 A 1,1 0 0 0 5,21 L 19,21 A 1,1 0 0 0 20,20 L 20,17"
                                          Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImportProgressTitle" Text="Importing Images..." FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtImportProgressStatus" Text="Optimizing and decoding..." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress Bar Container -->
                    <Border Background="#1E293B" CornerRadius="4" Height="7" Margin="0,4,0,8" ClipToBounds="True">
                        <Border x:Name="ImportProgressBarFill" HorizontalAlignment="Left" Width="0" Background="#38BDF8" CornerRadius="4"/>
                    </Border>

                    <!-- Progress Statistics Row -->
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtImportProgressPercent" DockPanel.Dock="Right" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TxtImportProgressCount" Text="0 of 0 processed" FontSize="11" Foreground="#94A3B8"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast Notifications Container (Bottom-Left) -->
        <StackPanel x:Name="ToastContainer" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Margin="24,0,0,24" 
                    MaxHeight="180"
                    ClipToBounds="True"
                    Panel.ZIndex="4000"
                    IsHitTestVisible="False"/>
    </Grid>
</Window>
