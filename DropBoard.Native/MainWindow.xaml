                    <Border Grid.Row="2" Background="#141824" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="18,12">
                        <Button HorizontalAlignment="Right" Style="{StaticResource TbButton}" Content="Done" Click="BtnCloseAboutModal_Click"
                                Background="#38BDF8" Foreground="#000000" FontWeight="Bold" Padding="20,6" BorderThickness="0"/>
