                        <!-- Project File Association Box -->
                        <Border Background="#0C1019" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Content="Refresh Icon" Click="BtnRefreshAssoc_Click" VerticalAlignment="Center" Padding="10,5" Foreground="#38BDF8" BorderBrush="#38BDF8"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Project File Association (.dropboard)" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,2"/>
