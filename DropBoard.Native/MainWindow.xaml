<Window x:Class="DropBoard.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DropBoard Studio"
        Icon="app_icon.ico"
        Height="850" Width="1350"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Canvas Background Opacity Slider Style (Dark / Cyan Minimalist Pill) -->
        <Style x:Key="CanvasOpacitySliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="4" CornerRadius="2" Background="#263445" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="#38BDF8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Width="10" Height="10" CornerRadius="5" 
                                                        Background="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#7DD3FC"/>
                                                        <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#BAE6FD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Video Timeline Scrubber Slider Style (Dark / Cyan Glowing Minimalist) -->
        <Style x:Key="VideoTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="4" CornerRadius="2" Background="#334155" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="#38BDF8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Width="10" Height="10" CornerRadius="5" 
                                                        Background="#38BDF8" BorderBrush="#FFFFFF" BorderThickness="1.5" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#7DD3FC"/>
                                                        <Setter TargetName="thumbBorder" Property="Width" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="Height" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="CornerRadius" Value="6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#BAE6FD"/>
                                                        <Setter TargetName="thumbBorder" Property="Width" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="Height" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="CornerRadius" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar & Dock Button Style -->
        <Style x:Key="TbButton" TargetType="Button">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                                <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AeButton" TargetType="Button" BasedOn="{StaticResource DockBtn}">
            <Setter Property="Foreground" Value="#9999FF"/>
        </Style>

        <Style x:Key="PsButton" TargetType="Button" BasedOn="{StaticResource DockBtn}">
            <Setter Property="Foreground" Value="#31A8FF"/>
        </Style>

        <Style x:Key="WinControlBtn" TargetType="Button" BasedOn="{StaticResource TbButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <Viewbox Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="10" Height="10">
                                    <Line X1="1" Y1="1" X2="9" Y2="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="9" Y1="1" X2="1" Y2="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E02424"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#F05252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Container: Dynamic Background Brush controls canvas transparency -->
    <Grid x:Name="RootGrid" Background="#00000000" ClipToBounds="True">
        
        <!-- Infinite Canvas Viewport -->
        <Grid x:Name="CanvasContainer" 
              Background="Transparent"
              PreviewMouseDown="CanvasContainer_PreviewMouseDown"
              MouseDown="CanvasContainer_MouseDown"
              MouseMove="CanvasContainer_MouseMove"
              MouseUp="CanvasContainer_MouseUp"
              PreviewMouseWheel="CanvasContainer_PreviewMouseWheel"
              MouseWheel="CanvasContainer_MouseWheel">
            
            <!-- Transformable Canvas World -->
            <Canvas x:Name="WorldCanvas">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="CanvasMatrixTransform"/>
                </Canvas.RenderTransform>

                <!-- Marquee Selection Rectangle -->
                <Rectangle x:Name="MarqueeSelectionBox"
                           Stroke="#38BDF8" StrokeThickness="1.5" StrokeDashArray="4 2"
                           Fill="#2638BDF8"
                           Visibility="Collapsed"/>

                <!-- Freehand Brush Overlay (Draw freely anywhere on the canvas) -->
                <InkCanvas x:Name="CanvasBrushOverlay"
                           Width="100000" Height="100000"
                           Canvas.Left="-50000" Canvas.Top="-50000"
                           Background="Transparent"
                           Panel.ZIndex="999999"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
            </Canvas>
        </Grid>

        <!-- Empty State Onboarding Overlay -->
        <Border x:Name="EmptyStateOverlay" 
                IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E612151D" BorderBrush="#22FFFFFF" BorderThickness="1"
                CornerRadius="16" Padding="36,26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="DropBoard STUDIO" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Native C# .NET 9.0 • 100% Desktop Transparency" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="• Drag &amp; Drop images from Explorer or web browser" FontSize="12" Foreground="#9CA3AF" Margin="0,2"/>
                <TextBlock Text="• Paste images from clipboard with Ctrl+V" FontSize="12" Foreground="#9CA3AF" Margin="0,2"/>
                <TextBlock Text="• Click &amp; Drag 4 corner dots to Resize proportionally" FontSize="12" Foreground="#9CA3AF" Margin="0,2"/>
                <TextBlock Text="• Click &amp; Drag empty canvas for Marquee Selection" FontSize="12" Foreground="#9CA3AF" Margin="0,2"/>
                <TextBlock Text="• Right-Click / Middle-Click / Space to Pan canvas" FontSize="12" Foreground="#9CA3AF" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- TOP TITLEBAR (Authentic DropBoard STUDIO)               -->
        <!-- ========================================================= -->
        <Border x:Name="TopTitleBar" Height="40" VerticalAlignment="Top" Panel.ZIndex="1000"
                Background="#FF0D0F14" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleDragArea_MouseDown">
            <DockPanel Margin="10,0,8,0" LastChildFill="True">
                <!-- 1. Window System Buttons (TOP PRIORITY - ALWAYS FAR RIGHT, NEVER CLIPPED) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource WinControlBtn}" Click="BtnMinimize_Click" Margin="0,0,3,0">
                        <Viewbox Width="10" Height="10">
                            <Canvas Width="10" Height="10">
                                <Line X1="1" Y1="5" X2="9" Y2="5" Stroke="#9CA3AF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource WinControlBtn}" Click="BtnMaximize_Click" Margin="0,0,3,0">
                        <Viewbox Width="9.5" Height="9.5">
                            <Canvas Width="10" Height="10">
                                <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="9" Height="9" Stroke="#9CA3AF" StrokeThickness="1.2" RadiusX="1" RadiusY="1" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}" Click="BtnClose_Click"/>
                </StackPanel>

                <!-- 2. Right Secondary Tools (Pin, Opacity, About, Settings) -->
                <StackPanel x:Name="PanelRightTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <!-- Pin Always on Top -->
                    <Button x:Name="BtnPin" Style="{StaticResource TbButton}" Click="BtnPin_Click" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnPin" Width="12.5" Height="12.5" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <!-- Needle -->
                                    <Line x:Name="PinLine4" X1="12" Y1="16.5" X2="12" Y2="22.5" Stroke="#9CA3AF" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                    <!-- Cap -->
                                    <Line x:Name="PinLine1" X1="7" Y1="4" X2="17" Y2="4" Stroke="#9CA3AF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Pushpin Body (Fills dynamically with cyan when pinned!) -->
                                    <Path x:Name="PinHead" 
                                          Data="M 8,4 L 16,4 L 16,9.5 L 18.5,13.5 L 18.5,16.5 L 5.5,16.5 L 5.5,13.5 L 8,9.5 Z" 
                                          Stroke="#9CA3AF" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnPin" Text="Pin" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Ellipse x:Name="PinDot" Width="6" Height="6" Fill="#555555" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Opacity Toggle Popover & Quick 0/100 Toggle -->
                    <Border x:Name="BorderOpacityContainer" Background="#14FFFFFF" CornerRadius="5" Padding="6,3" Margin="0,0,6,0"
                            ToolTip="Click icon or text to toggle 0% (Clear Glass) ⇄ 100% (Solid Dark)&#x0a;Drag slider for fine tuning&#x0a;Right-click for presets">
                        <Border.ContextMenu>
                            <ContextMenu Background="#161922" BorderBrush="#33FFFFFF" Foreground="#E5E7EB">
                                <MenuItem Header="0% Clear Glass (Desktop Transparent)" Click="MenuOpacityPreset_Click" Tag="0"/>
                                <MenuItem Header="25% Subtle Glass" Click="MenuOpacityPreset_Click" Tag="25"/>
                                <MenuItem Header="50% Balanced" Click="MenuOpacityPreset_Click" Tag="50"/>
                                <MenuItem Header="75% Deep Glass" Click="MenuOpacityPreset_Click" Tag="75"/>
                                <MenuItem Header="100% Solid Studio Dark" Click="MenuOpacityPreset_Click" Tag="100"/>
                                <Separator Background="#22FFFFFF"/>
                                <MenuItem x:Name="MenuTransparentTopBar" Header="Transparent Glass Top Bar" IsCheckable="True" Click="MenuTransparentTopBar_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 1-Click Quick Toggle Icon (0% ⇄ 100%) -->
                            <Border x:Name="BtnOpacityIcon" Cursor="Hand" Background="Transparent" 
                                    MouseLeftButtonDown="BtnOpacityToggle_Click" ToolTip="Click to toggle 0% ⇄ 100%">
                                <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="#38BDF8" StrokeThickness="2"/>
                                        <Path Data="M 12,3 A 9,9 0 0 1 12,21 Z" Fill="#38BDF8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <!-- Slider with DoubleClick Quick Toggle -->
                            <Slider x:Name="CanvasBgSlider" Style="{StaticResource CanvasOpacitySliderStyle}" Width="60" Minimum="0" Maximum="100" Value="100" 
                                    ValueChanged="CanvasBgSlider_ValueChanged" MouseDoubleClick="CanvasBgSlider_MouseDoubleClick"
                                    VerticalAlignment="Center"/>
                            <!-- Fixed Width Text Badge (Zero Jitter/Shift) with 1-Click Quick Toggle -->
                            <TextBlock x:Name="CanvasBgText" Text="100%" Width="36" TextAlignment="Right" 
                                       FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,0,0" 
                                       VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to toggle 0% (Clear Glass) ⇄ 100% (Solid Dark)"
                                       MouseLeftButtonDown="BtnOpacityToggle_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick 1-Click Transparent Glass Top Bar Toggle Button (Pure SVG Icon) -->
                    <Button x:Name="BtnTitlebarGlass" Style="{StaticResource TbButton}" Click="BtnTitlebarGlass_Click" Margin="0,0,4,0"
                            ToolTip="Toggle Transparent Glass Top Bar">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <!-- Window Outline -->
                                <Rectangle x:Name="GlassWinRect" Canvas.Left="2.5" Canvas.Top="3" Width="19" Height="18" RadiusX="3" RadiusY="3" 
                                           Stroke="#9CA3AF" StrokeThickness="1.8" Fill="Transparent"/>
                                <!-- Top Bar Section Area -->
                                <Rectangle x:Name="GlassWinHeader" Canvas.Left="2.5" Canvas.Top="3" Width="19" Height="6" RadiusX="3" RadiusY="3" 
                                           Fill="Transparent"/>
                                <!-- Top Bar Divider Line -->
                                <Line x:Name="GlassWinLine" X1="2.5" Y1="9" X2="21.5" Y2="9" Stroke="#9CA3AF" StrokeThickness="1.5"/>
                                <!-- Window Control Dots -->
                                <Ellipse x:Name="GlassDot1" Canvas.Left="5.5" Canvas.Top="5" Width="2" Height="2" Fill="#9CA3AF"/>
                                <Ellipse x:Name="GlassDot2" Canvas.Left="9" Canvas.Top="5" Width="2" Height="2" Fill="#9CA3AF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button x:Name="BtnAbout" Style="{StaticResource TbButton}" Click="BtnAbout_Click" Margin="0,0,4,0" ToolTip="About DropBoard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnAbout" Width="12" Height="12" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#9CA3AF" StrokeThickness="2"/>
                                    <Line X1="12" Y1="16" X2="12" Y2="11" Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="10.8" Canvas.Top="6.8" Width="2.4" Height="2.4" Fill="#9CA3AF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnAbout" Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSettings" Style="{StaticResource TbButton}" Click="BtnSettings_Click" Margin="0,0,2,0" ToolTip="Settings">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12.22,2 L 11.78,2 A 2,2 0 0 0 9.78,4 L 9.78,4.18 A 2,2 0 0 1 8.78,5.91 L 8.35,6.16 A 2,2 0 0 1 6.35,5.96 L 6.2,5.88 A 2,2 0 0 0 3.47,6.61 L 3.25,6.99 A 2,2 0 0 0 3.98,9.72 L 4.13,9.82 A 2,2 0 0 1 5.13,11.54 L 5.13,12.05 A 2,2 0 0 1 4.13,13.79 L 3.98,13.88 A 2,2 0 0 0 3.25,16.61 L 3.47,16.99 A 2,2 0 0 0 6.2,17.72 L 6.35,17.64 A 2,2 0 0 1 8.35,17.44 L 8.78,17.69 A 2,2 0 0 1 9.78,19.42 L 9.78,19.6 A 2,2 0 0 0 11.78,21.6 L 12.22,21.6 A 2,2 0 0 0 14.22,19.6 L 14.22,19.42 A 2,2 0 0 1 15.22,17.69 L 15.65,17.44 A 2,2 0 0 1 17.65,17.64 L 17.8,17.72 A 2,2 0 0 0 20.53,16.99 L 20.75,16.61 A 2,2 0 0 0 20.02,13.88 L 19.87,13.79 A 2,2 0 0 1 18.87,12.05 L 18.87,11.54 A 2,2 0 0 1 19.87,9.82 L 20.02,9.72 A 2,2 0 0 0 20.75,6.99 L 20.53,6.61 A 2,2 0 0 0 17.8,5.88 L 17.65,5.96 A 2,2 0 0 1 15.65,6.16 L 15.22,5.91 A 2,2 0 0 1 14.22,4.18 L 14.22,4 A 2,2 0 0 0 12.22,2 Z" 
                                      Stroke="#9CA3AF" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="#9CA3AF" StrokeThickness="1.6"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- 3. Left App Brand & Project Actions (Fills remaining space, clips gracefully without overflowing) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <!-- Brand Icon (Authentic 1:1 Vector SVG) -->
                    <Viewbox x:Name="IconBrand" Width="20" Height="20" Margin="0,0,7,0">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" RadiusX="5.5" RadiusY="5.5" Fill="#0C1019" Stroke="#5938BDF8" StrokeThickness="1"/>
                            <Rectangle Canvas.Left="4.5" Canvas.Top="4.5" Width="4.5" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8"/>
                            <Path Data="M 10,4.5 L 15,4.5 A 4.5,4.5 0 0 1 19.5,9 L 19.5,10.2 A 1.3,1.3 0 0 1 18.2,11.5 L 10,11.5 Z" Fill="#FFFFFF"/>
                            <Path Data="M 10,12.5 L 18.2,12.5 A 1.3,1.3 0 0 1 19.5,13.8 L 19.5,15 A 4.5,4.5 0 0 1 15,19.5 L 10,19.5 Z" Fill="#38BDF8"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock x:Name="TxtBrandTitle" Text="DropBoard" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border x:Name="BrandBadgeStudio" Background="#263B82F6" BorderBrush="#4D3B82F6" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" FontSize="9" FontWeight="Bold" Foreground="#60A5FA"/>
                    </Border>

                    <!-- Project Info -->
                    <Viewbox x:Name="IconFolder" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 22,19 A 2,2 0 0 1 20,21 L 4,21 A 2,2 0 0 1 2,19 L 2,5 A 2,2 0 0 1 4,3 L 9,3 L 11,6 L 20,6 A 2,2 0 0 1 22,8 Z" 
                                  Stroke="#38BDF8" StrokeThickness="2" Fill="Transparent"/>
