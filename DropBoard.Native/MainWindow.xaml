                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#38BDF8" StrokeThickness="2"/>
                                        <Line X1="12" Y1="16" X2="12" Y2="12" Stroke="#38BDF8" StrokeThickness="2"/>
                                        <Line X1="12" Y1="8" X2="12" Y2="8.01" Stroke="#38BDF8" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="About DropBoard Studio" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Modal Body -->
                    <StackPanel Grid.Row="1" Margin="22,18" HorizontalAlignment="Stretch">
                        <!-- Hero Header -->
                        <Border Background="#08FFFFFF" BorderBrush="#2538BDF8" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <DockPanel LastChildFill="True">
                                <Viewbox DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Viewbox.Effect>
                                        <DropShadowEffect BlurRadius="14" Color="#38BDF8" Opacity="0.5" ShadowDepth="0"/>
                                    </Viewbox.Effect>
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21" RadiusX="5.5" RadiusY="5.5" Fill="#0C1019" Stroke="#7338BDF8" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="4.5" Canvas.Top="4.5" Width="4.5" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8"/>
                                        <Path Data="M10 4.5h5a4.5 4.5 0 0 1 4.5 4.5v1.2a1.3 1.3 0 0 1-1.3 1.3H10V4.5z" Fill="#FFFFFF"/>
                                        <Path Data="M10 12.5h8.2a1.3 1.3 0 0 1 1.3 1.3v1.2a4.5 4.5 0 0 1-4.5 4.5H10v-7z" Fill="#38BDF8"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="DropBoard Studio" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Border Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </Border>
                                        <Border Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="5" Padding="6,2">
                                            <TextBlock Text="Windows Native C# .NET 9" FontSize="10.5" FontWeight="SemiBold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="High-performance infinite reference board &amp; dynamic canvas workspace for motion designers, 3D artists, and visual creators. Deep Adobe After Effects &amp; Photoshop pipeline integration."
                                               FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Creator Profile Card -->
                        <Border Background="#0C1019" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CREATOR &amp; DEVELOPER" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="MG" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
