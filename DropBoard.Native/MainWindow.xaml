                </Grid>
            </Border>
        </Grid>

        <!-- DropBoard Preferences & Settings Modal Overlay -->
        <Grid x:Name="SettingsModalOverlay" Panel.ZIndex="3000" Visibility="Collapsed" Background="#C0070A0F" MouseDown="ModalBackdrop_MouseDown">
            <Border Width="680" MaxWidth="920" Height="580" MaxHeight="800" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FA0D1019" BorderBrush="#33FFFFFF" BorderThickness="1.2"
                    CornerRadius="14" Padding="0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" ShadowDepth="15" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#141824" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="18,14">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource WinCloseBtn}" Click="BtnCloseSettingsModal_Click"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Stroke="#38BDF8" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="#38BDF8" StrokeThickness="1.5" StrokeDashArray="2 2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="DropBoard Preferences &amp; Settings" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tab Buttons Row -->
                    <Border Grid.Row="1" Background="#0C0F17" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabBtnGeneral" Style="{StaticResource TbButton}" Content="General" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="General"/>
                            <Button x:Name="TabBtnNav" Style="{StaticResource TbButton}" Content="Navigation &amp; Input" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="Navigation"/>
                            <Button x:Name="TabBtnToolbar" Style="{StaticResource TbButton}" Content="Toolbar &amp; Layout" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="Toolbar"/>
                            <Button x:Name="TabBtnShortcuts" Style="{StaticResource TbButton}" Content="Shortcuts" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="Shortcuts"/>
                            <Button x:Name="TabBtnStorage" Style="{StaticResource TbButton}" Content="Storage &amp; Cache" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="Storage"/>
                            <Button x:Name="TabBtnAbout" Style="{StaticResource TbButton}" Content="About &amp; Creator" Margin="0,0,4,0" Click="SettingsTab_Click" Tag="About"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Panes Container (ScrollViewer) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18">
                        <Grid>
                            <!-- Tab 1: General -->
                            <StackPanel x:Name="PaneGeneral" Visibility="Visible">
                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="ChkAutoSave" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True" Checked="SettingAutoSave_Changed" Unchecked="SettingAutoSave_Changed"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Automatic Project Saving" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,3"/>
                                            <TextBlock Text="Continuously auto-saves board state so you never lose progress on exit." FontSize="11.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtAutoSaveStatus" Text="Status: Auto-Save Active" FontSize="10.5" FontWeight="SemiBold" Foreground="#34D399" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Content="Save Project (Ctrl+S)" Click="BtnSaveProject_Click" Padding="12,6" Foreground="#38BDF8" BorderBrush="#38BDF8" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Save Standalone Project File (.dropboard)" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,3"/>
                                            <TextBlock Text="Save standalone file with embedded images or links for portability." FontSize="11.5" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 2: Navigation & Touchpad -->
                            <StackPanel x:Name="PaneNavigation" Visibility="Collapsed">
                                <TextBlock Text="Input &amp; Navigation Mode" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose how you prefer to navigate the canvas using touchpad or mouse." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <!-- macOS Trackpad -->
                                    <Border x:Name="CardNavMac" Background="#0C1019" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="SelectNavMode_Click" Tag="macos">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Rectangle x:Name="IconNavMacScreen" Canvas.Left="3" Canvas.Top="4" Width="18" Height="11" RadiusX="2" RadiusY="2" Stroke="#38BDF8" StrokeThickness="1.8" Fill="Transparent"/>
                                                        <Line x:Name="IconNavMacBase" X1="1" Y1="19" X2="23" Y2="19" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Rectangle x:Name="IconNavMacPad" Canvas.Left="9" Canvas.Top="16" Width="6" Height="3" RadiusX="0.5" RadiusY="0.5" Stroke="#38BDF8" StrokeThickness="1.2" Fill="Transparent"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="TxtNavMacTitle" Text="macOS Trackpad" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="2-Finger Pan &amp; Pinch Zoom" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Windows Precision -->
                                    <Border x:Name="CardNavWin" Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="3,0,3,0" Cursor="Hand" MouseLeftButtonDown="SelectNavMode_Click" Tag="windows">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
