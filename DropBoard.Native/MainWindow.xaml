                    </Viewbox>
                    <TextBlock x:Name="TxtProjectTitle" Text="untitled" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtMetaDivider" Text="•" FontSize="9" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtRefCountTop" Text="0 References" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Action Buttons with SVG Icons -->
                    <Button x:Name="BtnNew" Style="{StaticResource TbButton}" Click="BtnNew_Click" Margin="0,0,4,0" ToolTip="New Board (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnNew" Width="13" Height="13" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 14,2 L 6,2 A 2,2 0 0 0 4,4 L 4,20 A 2,2 0 0 0 6,22 L 18,22 A 2,2 0 0 0 20,20 L 20,8 Z M 14,2 L 14,8 L 20,8 M 12,18 L 12,12 M 9,15 L 15,15" 
                                          Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnNew" Text="New" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOpenDropboard" Style="{StaticResource TbButton}" Click="BtnOpenDropboard_Click" Margin="0,0,4,0" ToolTip="Open .dropboard (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnOpen" Width="13" Height="13" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 21,15 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,15 M 7,10 L 12,5 L 17,10 M 12,5 L 12,17" 
                                          Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnOpen" Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSave" Style="{StaticResource TbButton}" Click="BtnSave_Click" Margin="0,0,4,0" ToolTip="Save Project (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnSave" Width="13" Height="13" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,5 A 2,2 0 0 1 5,3 L 16,3 L 21,8 L 21,19 A 2,2 0 0 1 19,21 Z M 17,21 L 17,13 L 7,13 L 7,21 M 7,3 L 7,8 L 15,8 L 15,3" 
                                          Stroke="#38BDF8" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnSave" Text="Save" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveAs" Style="{StaticResource TbButton}" Click="BtnSaveAs_Click" Margin="0,0,4,0" ToolTip="Save As... (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconBtnSaveAs" Width="13" Height="13" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,5 A 2,2 0 0 1 5,3 L 16,3 L 21,8 L 21,19 A 2,2 0 0 1 19,21 Z M 17,21 L 17,13 L 7,13 L 7,21 M 12,9 L 12,15 M 9,12 L 15,12" 
                                          Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnSaveAs" Text="Save As" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DockHoverZone removed from hit-testing: Window_PreviewMouseMove handles auto-hide floating dock globally without blocking canvas clicks -->
        <Border x:Name="DockHoverZone" Height="0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="Transparent" Panel.ZIndex="99" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- ========================================================= -->
        <!-- FLOATING ACTION DOCK (Authentic DropBoard STUDIO Vector Icons) -->
        <!-- ========================================================= -->
        <Border x:Name="FloatingDock" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0"
                Panel.ZIndex="100"
                Background="#E612151D" BorderBrush="#26FFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="6,3"
                MouseEnter="FloatingDock_MouseEnter"
                MouseLeave="FloatingDock_MouseLeave"
                MouseLeftButtonDown="FloatingDock_MouseLeftButtonDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTranslateTransform"/>
            </Border.RenderTransform>
            <ScrollViewer x:Name="DockScrollViewer" 
                          VerticalScrollBarVisibility="Hidden" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <WrapPanel x:Name="DockWrapPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Group 1: Add Items -->
                <!-- + File -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddImage_Click" ToolTip="Add Image from computer (or Drag &amp; Drop anywhere)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Line X1="12" Y1="5" X2="12" Y2="19" Stroke="#9CA3AF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="5" Y1="12" X2="19" Y2="12" Stroke="#9CA3AF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="File" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- URL -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddUrl_Click" ToolTip="Add Web Reference (Pinterest / YouTube / Web Image)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Line X1="2" Y1="12" X2="22" Y2="12" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Path Data="M 12,2 A 15.3,15.3 0 0 1 16,12 A 15.3,15.3 0 0 1 12,22 A 15.3,15.3 0 0 1 8,12 A 15.3,15.3 0 0 1 12,2 Z" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="URL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Note -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddNote_Click" ToolTip="Add Sticky Note / Text Card (Press N)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 4,4 L 16,4 L 20,8 L 20,20 L 4,20 Z" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <Path Data="M 16,4 L 16,8 L 20,8" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <Line X1="8" Y1="10" X2="13" Y2="10" Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="8" Y1="14" X2="16" Y2="14" Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Note" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Checklist -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddChecklist_Click" ToolTip="Add Checklist &amp; Deadline Task Card (Press T)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="5" Height="5" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.8" Fill="Transparent"/>
                                <Line X1="11" Y1="6.5" X2="21" Y2="6.5" Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="12" Width="5" Height="5" RadiusX="1" RadiusY="1" Stroke="#10B981" StrokeThickness="1.8" Fill="#10B981"/>
                                <Path Data="M 4.5,14.5 L 5.8,15.8 L 7.5,13.2" Stroke="#0F172A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Line X1="11" Y1="14.5" X2="21" Y2="14.5" Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Checklist" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Freehand Brush Tool -->
                <Button x:Name="BtnAddDraw" Style="{StaticResource DockBtn}" Click="BtnAddDraw_Click" ToolTip="Freehand Canvas Brush Tool (Press B / P to draw freely anywhere)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="IconBrushPath" Data="M 17 3 a 2.85 2.83 0 1 1 4 4 L 7.5 20.5 L 2 22 L 3.5 16.5 Z" Stroke="#9CA3AF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Line x:Name="IconBrushLine" X1="15" Y1="5" X2="19" Y2="9" Stroke="#9CA3AF" StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtBrushBtn" Text="Brush" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Group -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddGroup_Click" ToolTip="Add Section / Scene Group Frame with Notes">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="3" RadiusY="3" Stroke="#9CA3AF" StrokeThickness="2" StrokeDashArray="3 2"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="3" Stroke="#9CA3AF" StrokeThickness="1.5" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Group" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Node -->
                <Button Style="{StaticResource DockBtn}" Click="BtnAddNode_Click" ToolTip="Add Creative Node (Note, Typography, VFX, Schedule)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="14" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Path Data="M 10,6.5 L 14,6.5 A 2,2 0 0 1 16,8.5 L 16,14" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Node" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="#22FFFFFF" Margin="5,0"/>

                <!-- Group 2: Layout & Arrange -->
                <!-- Grid -->
                <Button Style="{StaticResource DockBtn}" Click="BtnGridArrange_Click" ToolTip="Auto-Arrange as Grid (Arranges selection or entire board)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="7" Stroke="#38BDF8" StrokeThickness="2"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="3" Width="7" Height="7" Stroke="#38BDF8" StrokeThickness="2"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="14" Width="7" Height="7" Stroke="#38BDF8" StrokeThickness="2"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="14" Width="7" Height="7" Stroke="#38BDF8" StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Grid" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pipeline -->
                <Button Style="{StaticResource DockBtn}" Click="BtnPipelineArrange_Click" ToolTip="Storyboard Pipeline (Arranges selection horizontally)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Line X1="3" Y1="6" X2="8" Y2="6" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Line X1="3" Y1="12" X2="8" Y2="12" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Line X1="3" Y1="18" X2="8" Y2="18" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="4" Width="9" Height="4" RadiusX="1" RadiusY="1" Stroke="#9CA3AF" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="10" Width="9" Height="4" RadiusX="1" RadiusY="1" Stroke="#9CA3AF" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="16" Width="9" Height="4" RadiusX="1" RadiusY="1" Stroke="#9CA3AF" StrokeThickness="1.5"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Pipeline" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Gap -->
                <Button Style="{StaticResource DockBtn}" Click="BtnGapToggle_Click" ToolTip="Adjust Auto-Arrange Spacing &amp; Gap">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Line X1="4" Y1="21" X2="4" Y2="3" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Line X1="20" Y1="21" X2="20" Y2="3" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Polyline Points="9,8 5,12 9,16" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <Polyline Points="15,16 19,12 15,8" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtGap" Text="Gap: 24px" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="#22FFFFFF" Margin="5,0"/>

                <!-- Group 3: History -->
                <!-- Undo -->
                <Button Style="{StaticResource DockBtn}" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="3,7 3,13 9,13" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <Path Data="M 21,17 A 9,9 0 0 0 12,8 A 9,9 0 0 0 6,10.3 L 3,13" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Undo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Redo -->
                <Button Style="{StaticResource DockBtn}" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="21,7 21,13 15,13" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <Path Data="M 3,17 A 9,9 0 0 1 12,8 A 9,9 0 0 1 18,10.3 L 21,13" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Redo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="#22FFFFFF" Margin="5,0"/>

                <!-- Group 4: App Integration & Export -->
                <!-- Ae Export -->
                <Button Style="{StaticResource AeButton}" Click="BtnAeExport_Click" ToolTip="Export selected Scene Comp or Reference Images to Adobe After Effects">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2E284A" BorderBrush="#4A3F75" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="Ae" FontSize="9.5" FontWeight="Bold" Foreground="#9999FF"/>
                        </Border>
                        <TextBlock Text="Export" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Ps Open -->
                <Button Style="{StaticResource PsButton}" Click="BtnPsOpen_Click" ToolTip="Send selected reference to Adobe Photoshop">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#16314A" BorderBrush="#1D4C75" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="Ps" FontSize="9.5" FontWeight="Bold" Foreground="#31A8FF"/>
                        </Border>
                        <TextBlock Text="Open" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Copy -->
                <Button Style="{StaticResource DockBtn}" Click="BtnCopy_Click" ToolTip="Copy selected reference as File to Clipboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="13" Height="13" RadiusX="2" RadiusY="2" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Path Data="M 5,15 L 4,15 A 2,2 0 0 1 2,13 L 2,4 A 2,2 0 0 1 4,2 L 13,2 A 2,2 0 0 1 15,4 L 15,5" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="#22FFFFFF" Margin="5,0"/>

                <!-- Group 5: Tools & Settings -->
                <!-- Pin / Float -->
                <Button x:Name="BtnDockPin" Style="{StaticResource DockBtn}" Click="BtnFloatToggle_Click" ToolTip="Toggle Toolbar Auto-Hide / Pin Position">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Line x:Name="DockPinLine" X1="12" Y1="17" X2="12" Y2="22" Stroke="#9CA3AF" StrokeThickness="2"/>
                                <Path x:Name="DockPinPath" Data="M 5,17 L 19,17 L 19,15 L 17,12 L 17,6 A 1,1 0 0 0 16,5 L 8,5 A 1,1 0 0 0 7,6 L 7,12 L 5,15 Z" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtFloat" Text="Pin" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Sidebar / Top Bar Toggle (1x Mode) -->
                <Button x:Name="BtnDockPosToggle" Style="{StaticResource DockBtn}" Click="BtnDockPosToggle_Click" ToolTip="Switch Toolbar Position (Left Sidebar 1x Mode)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle x:Name="IconDockPosWindow" Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                <!-- When in Top Bar, show Sidebar icon (click to switch to sidebar) -->
                                <Rectangle x:Name="IconDockPosSidebar" Canvas.Left="3" Canvas.Top="3" Width="6" Height="18" RadiusX="2" RadiusY="2" Fill="#9CA3AF" Visibility="Visible"/>
                                <!-- When in Sidebar, show Top Bar icon (click to switch to top bar) -->
                                <Rectangle x:Name="IconDockPosTopbar" Canvas.Left="3" Canvas.Top="3" Width="18" Height="6" RadiusX="2" RadiusY="2" Fill="#9CA3AF" Visibility="Collapsed"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtDockPos" Text="Sidebar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Duplicate -->
                <Button Style="{StaticResource DockBtn}" Click="BtnDuplicate_Click" ToolTip="Duplicate selected (Ctrl+D)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 14,2 L 6,2 A 2,2 0 0 0 4,4 L 4,16 A 2,2 0 0 0 6,18 L 14,18 A 2,2 0 0 0 16,16 L 16,4 Z M 8,18 L 8,22 A 2,2 0 0 0 10,24 L 18,24 A 2,2 0 0 0 20,22 L 20,8 A 2,2 0 0 0 18,6 L 16,6" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Clear -->
                <Button Style="{StaticResource DockBtn}" Click="BtnClear_Click" ToolTip="Clear all references">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Polyline Points="3,6 5,6 21,6" Stroke="#EF4444" StrokeThickness="2" Fill="Transparent"/>
                                <Path Data="M 19,6 L 19,20 A 2,2 0 0 1 17,22 L 7,22 A 2,2 0 0 1 5,20 L 5,6 M 8,6 L 8,4 A 2,2 0 0 1 10,2 L 14,2 A 2,2 0 0 1 16,4 L 16,6" Stroke="#EF4444" StrokeThickness="2" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Clear" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- Freehand Brush Floating Options Bar -->
        <Border x:Name="BrushModeBar"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"
                Panel.ZIndex="105"
                Background="#EB12151D" BorderBrush="#38BDF8" BorderThickness="1.2"
                CornerRadius="8" Padding="10,5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
