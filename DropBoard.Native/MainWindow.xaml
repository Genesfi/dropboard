                    <DropShadowEffect BlurRadius="45" ShadowDepth="15" Opacity="0.8" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#141824" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="18,14">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource WinCloseBtn}" Click="BtnCloseAboutModal_Click"/>
